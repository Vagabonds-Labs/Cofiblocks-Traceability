# Stellar CLI identity that deploys and administers the contract.
# Created with `stellar keys generate` (see ../scripts/setup-testnet.sh).
STELLAR_ADMIN_IDENTITY=cofi-admin

# RPC. Leave empty to use the public endpoints.
STELLAR_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
STELLAR_RPC_URL_MAINNET=https://mainnet.sorobanrpc.com
