# Supabase settings
DATABASE_URL="postgresql://postgres..."
DIRECT_URL="postgresql://postgres..."

PORT=4000
FRONTEND_URL="http://localhost:3000"

# Origen público del backend. Junto con FRONTEND_URL decide si las cookies de
# sesión se emiten como cross-domain (SameSite=None; Secure). Si el frontend
# está en otro dominio — Vercel, por ejemplo — y esto queda mal, el login falla
# en silencio: el navegador descarta la cookie y el usuario nunca queda logueado.
BACKEND_URL="http://localhost:4000"
# Fuerza el modo cross-domain sin depender de la comparación de arriba.
ALLOW_CROSS_DOMAIN_COOKIES=false

# ── Supabase Storage (fotos, recibos y documentos) ───────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# ── Stellar ───────────────────────────────────────────────────────────────
# testnet | mainnet
STELLAR_NETWORK=testnet

# Cuenta del backend. Es el admin del contrato de trazabilidad, paga los fees
# de los usuarios vía fee-bump y crea sus cuentas, así nadie necesita XLM.
# Clave secreta S… de la identidad que despliega el contrato:
#   stellar keys show cofi-admin
STELLAR_ADMIN_SECRET=

# Opcionales: si se dejan vacíos se usan los públicos de cada red.
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=

# Pisa la dirección del contrato de `deployments.ts` (p. ej. en mainnet, o para
# probar un despliegue nuevo).
STELLAR_TRACEABILITY_ADDRESS=

# ── Bot de Telegram de los caficultores ──────────────────────────────────
# Token de @BotFather. Vacío = bot apagado.
TELEGRAM_BOT_TOKEN=
# En staging/producción: URL pública de POST /api/telegram/webhook y un secreto
# cualquiera. Vacíos = long polling (desarrollo local).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# development for more log verbosity and also for cookie setting
NODE_ENV=development

# Secretos de las sesiones. Obligatorios: el backend no arranca si faltan, si
# tienen menos de 32 caracteres o si son iguales entre sí. Generar cada uno con
#   openssl rand -hex 32
# JWT_ACCESS_SECRET tiene que ser igual a JWT_SECRET de la webapp.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=10m
JWT_REFRESH_EXPIRY=7d
