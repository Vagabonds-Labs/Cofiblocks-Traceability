# Supabase settings
DATABASE_URL="postgresql://postgres..."
DIRECT_URL="postgresql://postgres..."

PORT=4000
FRONTEND_URL="http://localhost:3000"

# Public origin of the backend. Together with FRONTEND_URL it decides whether
# session cookies are issued as cross-domain (SameSite=None; Secure). If the
# frontend is on another domain — Vercel, for example — and this is wrong,
# login fails silently: the browser drops the cookie and the user never stays
# signed in.
BACKEND_URL="http://localhost:4000"
# Forces cross-domain mode without relying on the comparison above.
ALLOW_CROSS_DOMAIN_COOKIES=false

# ── Supabase Storage (photos, receipts and documents) ────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# ── Stellar ───────────────────────────────────────────────────────────────
# testnet | mainnet (defaults to testnet if empty)
STELLAR_NETWORK=testnet

# Backend account. It is the admin of the traceability contract and pays the
# users' fees via fee-bump, so nobody needs XLM.
# Secret key S… of the identity that deploys the contract:
#   stellar keys show cofi-admin
STELLAR_ADMIN_SECRET=

# Farmer agent: the only account the contract accepts for farmer actions
# (farmers have no wallet). Its address is set in the contract by deploy.sh.
#   stellar keys show cofi-farmer-agent
STELLAR_FARMER_AGENT_SECRET=

# Testnet faucet that funds new staff wallets (testnet only).
#   stellar keys show cofi-faucet
STELLAR_FAUCET_SECRET=
# XLM sent to each staff wallet, once (default 10).
FAUCET_AMOUNT_XLM=

# Optional: if left empty, each network's public endpoints are used.
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=

# Overrides the contract address in `deployments.ts` (e.g. on mainnet, or to
# try a new deployment).
STELLAR_TRACEABILITY_ADDRESS=

# ── VoiceLedger integration (farmers' bot) ──────────────────────────────
# Shared secret for the HMAC signature of VoiceLedger's events. Empty = the
# integration endpoint answers 503. Generate with: openssl rand -hex 32
VOICELEDGER_WEBHOOK_SECRET=

# ── Farmers' Telegram bot (prototype, no longer used) ────────────────────
# Token from @BotFather. Empty = bot off.
TELEGRAM_BOT_TOKEN=
# On staging/production: public URL of POST /api/telegram/webhook and any
# secret. Empty = long polling (local development).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# development for more log verbosity and also for cookie setting
NODE_ENV=development

# Session secrets. Required: the backend refuses to start if they are missing,
# shorter than 32 characters or equal to each other. Generate each one with
#   openssl rand -hex 32
# JWT_ACCESS_SECRET must match the web app's JWT_SECRET.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=10m
JWT_REFRESH_EXPIRY=7d

# ── Pilot settings (see src/config/pilot.ts) ─────────────────────────────
# Hectares per fachasa. Empty until the cooperatives confirm it: plot areas
# keep their original value and unit, and hectares stay empty.
FACHASA_TO_HECTARES=
# Plots must fall inside this box: "minLat,minLng,maxLat,maxLng". Empty uses
# a generous box around Gomma woreda.
FARM_AREA_BBOX=
