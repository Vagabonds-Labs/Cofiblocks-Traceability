generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── personal y autenticación ──────────────────────────────────────────────

/// Persona que entra a la app web: personal de las cooperativas y de la unión,
/// y los admins de CofiBlocks. Los caficultores no son `User`: usan el bot y
/// viven en `Farmer`.
model User {
  id                    String            @id @default(uuid())
  name                  String?
  email                 String?
  /// Usuario de Telegram, si entró con Telegram (vía Cavos).
  telegramUsername      String?           @map("telegram_username")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  isAdmin               Boolean           @default(false) @map("is_admin")
  walletAddress         String?           @unique @map("wallet_address")
  walletProvider        String?           @map("wallet_provider")
  /// Rol en el piloto. `null` hasta que un admin se lo asigna.
  role                  StaffRole?
  organizationId        String?           @map("organization_id")
  /// Sólo para los Coffee Collectors: su centro de acopio.
  collectionCenterId    String?           @map("collection_center_id")
  /// Transacción que dejó el rol en el contrato.
  roleTx                String?           @map("role_tx")
  organization          Organization?     @relation(fields: [organizationId], references: [id])
  collectionCenter      CollectionCenter? @relation(fields: [collectionCenterId], references: [id])
  notificationsReceived Notification[]    @relation("NotificationReceiver")
  notificationsSent     Notification[]    @relation("NotificationSender")
  refreshTokens         RefreshToken[]
  sessions              Session[]

  @@map("users")
}

/// Nonce de login por firma de wallet. Lo emite `POST /auth/nonce`, vence
/// rápido y se consume una sola vez.
model AuthNonce {
  id            String    @id @default(uuid())
  nonce         String    @unique
  walletAddress String?   @map("wallet_address")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("auth_nonces")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  sessionId String?  @unique @map("session_id")
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Session {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  ipAddress    String?       @map("ip_address")
  userAgent    String?       @map("user_agent")
  deviceInfo   String?       @map("device_info")
  isActive     Boolean       @default(true) @map("is_active")
  lastActivity DateTime      @default(now()) @updatedAt @map("last_activity")
  createdAt    DateTime      @default(now()) @map("created_at")
  expiresAt    DateTime      @map("expires_at")
  refreshToken RefreshToken?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Notification {
  id         String            @id @default(uuid())
  receiverId String            @map("receiver_id")
  senderId   String?           @map("sender_id")
  key        String
  arguments  String[]          @default([])
  level      NotificationLevel
  readAt     DateTime?         @map("read_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  logs       String?
  receiver   User              @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User?             @relation("NotificationSender", fields: [senderId], references: [id])

  @@map("notifications")
}

// ── organizaciones ────────────────────────────────────────────────────────

/// Cooperativa o unión.
model Organization {
  id                String             @id @default(uuid())
  kind              OrganizationKind
  name              String
  /// Código corto, p. ej. `KK`. Prefija el `farmer_ref` on-chain.
  code              String             @unique
  /// Id numérico que usa el contrato (`org`/`coop`).
  chainId           Int                @unique @map("chain_id")
  region            String?
  zone              String?
  woreda            String?
  createdAt         DateTime           @default(now()) @map("created_at")
  collectionCenters CollectionCenter[]
  farmers           Farmer[]
  users             User[]

  @@map("organizations")
}

model CollectionCenter {
  id             String       @id @default(uuid())
  name           String
  /// Id numérico que usa el contrato (`collection_center`).
  chainId        Int          @unique @map("chain_id")
  organizationId String       @map("organization_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  farmers        Farmer[]
  users          User[]

  @@unique([organizationId, name])
  @@map("collection_centers")
}

// ── caficultores ──────────────────────────────────────────────────────────

/// Caficultor del piloto. Lo precarga la cooperativa (lista de IDs) y lo
/// completa el propio caficultor desde el bot de Telegram.
model Farmer {
  id                 String            @id @default(uuid())
  organizationId     String            @map("organization_id")
  /// ID que le asignó la cooperativa. Único dentro de la cooperativa.
  coopFarmerId       String            @map("coop_farmer_id")
  collectionCenterId String?           @map("collection_center_id")
  fullName           String?           @map("full_name")
  phone              String?
  /// Id numérico del usuario de Telegram. Se fija cuando el caficultor se
  /// identifica en el bot con su ID de cooperativa.
  telegramUserId     BigInt?           @unique @map("telegram_user_id")
  telegramUsername   String?           @map("telegram_username")
  language           String?
  status             FarmerStatus      @default(PRELOADED)
  /// Wallet Cavos, creada en la Mini App.
  walletAddress      String?           @unique @map("wallet_address")
  /// Transacción de `register_farmer`.
  registerTx         String?           @map("register_tx")
  consentHash        String?           @map("consent_hash")
  consentTx          String?           @map("consent_tx")
  consentAt          DateTime?         @map("consent_at")
  linkedAt           DateTime?         @map("linked_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  organization       Organization      @relation(fields: [organizationId], references: [id])
  collectionCenter   CollectionCenter? @relation(fields: [collectionCenterId], references: [id])
  botConversation    BotConversation?

  @@unique([organizationId, coopFarmerId])
  @@map("farmers")
}

/// Estado de la conversación del bot con un chat de Telegram. Vive en la base
/// para que el registro se pueda retomar donde quedó, aunque el backend se
/// reinicie.
model BotConversation {
  chatId    BigInt   @id @map("chat_id")
  farmerId  String?  @unique @map("farmer_id")
  language  String?
  step      String
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  farmer    Farmer?  @relation(fields: [farmerId], references: [id], onDelete: SetNull)

  @@map("bot_conversations")
}

// ── enums ─────────────────────────────────────────────────────────────────

/// Roles del personal. El orden y los nombres siguen el enum `Role` del
/// contrato (sin `Farmer`, que no es personal).
enum StaffRole {
  COLLECTOR
  COMMITTEE_MEMBER
  INDUSTRY_MANAGER
  STORE_KEEPER
  EXPORT_MANAGER
}

enum OrganizationKind {
  COOPERATIVE
  UNION
}

enum FarmerStatus {
  /// Cargado desde la lista de la cooperativa; todavía no habló con el bot.
  PRELOADED
  /// Se identificó en el bot con su ID; el registro está en curso.
  LINKED
  /// Completó el registro en el bot.
  REGISTERED
  /// Firmó el consentimiento EUDR en la Mini App.
  CONSENTED
}

enum NotificationLevel {
  WARNING
  INFO
  ERROR
}
