generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── staff and authentication ──────────────────────────────────────────────

/// Person who signs in to the web app: cooperative and union staff, and the
/// CofiBlocks admins. Farmers are not `User`s: they use the bot and live in
/// `Farmer`.
model User {
  id                    String            @id @default(uuid())
  name                  String?
  email                 String?
  /// Telegram username, if they signed in with Telegram (through Cavos).
  telegramUsername      String?           @map("telegram_username")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  isAdmin               Boolean           @default(false) @map("is_admin")
  walletAddress         String?           @unique @map("wallet_address")
  walletProvider        String?           @map("wallet_provider")
  /// Role in the pilot. `null` until an admin assigns one.
  role                  StaffRole?
  organizationId        String?           @map("organization_id")
  /// Coffee Collectors only: their collection center.
  collectionCenterId    String?           @map("collection_center_id")
  /// Transaction that wrote the role to the contract.
  roleTx                String?           @map("role_tx")
  /// Testnet XLM funding (faucet for Cavos wallets, Friendbot for own
  /// wallets). `fundTx` is stored before the payment is sent, with the
  /// transaction's expiry; `fundedAt` is set once it is confirmed.
  fundTx                String?           @map("fund_tx")
  fundTxValidUntil      DateTime?         @map("fund_tx_valid_until")
  fundedAt              DateTime?         @map("funded_at")
  organization          Organization?     @relation(fields: [organizationId], references: [id])
  collectionCenter      CollectionCenter? @relation(fields: [collectionCenterId], references: [id])
  notificationsReceived Notification[]    @relation("NotificationReceiver")
  notificationsSent     Notification[]    @relation("NotificationSender")
  refreshTokens         RefreshToken[]
  sessions              Session[]

  @@map("users")
}

/// Nonce for wallet-signature login. Issued by `POST /auth/nonce`, expires
/// quickly and can be used only once.
model AuthNonce {
  id            String    @id @default(uuid())
  nonce         String    @unique
  walletAddress String?   @map("wallet_address")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("auth_nonces")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  sessionId String?  @unique @map("session_id")
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Session {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  ipAddress    String?       @map("ip_address")
  userAgent    String?       @map("user_agent")
  deviceInfo   String?       @map("device_info")
  isActive     Boolean       @default(true) @map("is_active")
  lastActivity DateTime      @default(now()) @updatedAt @map("last_activity")
  createdAt    DateTime      @default(now()) @map("created_at")
  expiresAt    DateTime      @map("expires_at")
  refreshToken RefreshToken?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Notification {
  id         String            @id @default(uuid())
  receiverId String            @map("receiver_id")
  senderId   String?           @map("sender_id")
  key        String
  arguments  String[]          @default([])
  level      NotificationLevel
  readAt     DateTime?         @map("read_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  logs       String?
  receiver   User              @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User?             @relation("NotificationSender", fields: [senderId], references: [id])

  @@map("notifications")
}

// ── organizations ─────────────────────────────────────────────────────────

/// Cooperative or union.
model Organization {
  id                String             @id @default(uuid())
  kind              OrganizationKind
  name              String
  /// Short code, e.g. `KK`. Prefixes the on-chain `farmer_ref`.
  code              String             @unique
  /// Numeric ID used by the contract (`org`/`coop`).
  chainId           Int                @unique @map("chain_id")
  region            String?
  zone              String?
  woreda            String?
  createdAt         DateTime           @default(now()) @map("created_at")
  collectionCenters CollectionCenter[]
  farmers           Farmer[]
  users             User[]

  @@map("organizations")
}

model CollectionCenter {
  id             String       @id @default(uuid())
  name           String
  /// Numeric ID used by the contract (`collection_center`).
  chainId        Int          @unique @map("chain_id")
  organizationId String       @map("organization_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  farmers        Farmer[]
  users          User[]

  @@unique([organizationId, name])
  @@map("collection_centers")
}

// ── farmers ───────────────────────────────────────────────────────────────

/// Pilot farmer. Pre-loaded by the cooperative (list of IDs) and completed by
/// the farmer through the Telegram bot.
model Farmer {
  id                   String            @id @default(uuid())
  organizationId       String            @map("organization_id")
  /// ID assigned by the cooperative. Unique within the cooperative.
  coopFarmerId         String            @map("coop_farmer_id")
  collectionCenterId   String?           @map("collection_center_id")
  fullName             String?           @map("full_name")
  phone                String?
  /// Numeric Telegram user ID. Set when the farmer identifies themselves in
  /// the bot with their cooperative ID.
  telegramUserId       BigInt?           @unique @map("telegram_user_id")
  telegramUsername     String?           @map("telegram_username")
  language             String?
  status               FarmerStatus      @default(PRELOADED)
  /// `register_farmer` transaction, signed by the farmer agent. It is stored
  /// before it is sent, with its expiry, so a retry can reconcile it instead
  /// of sending another one; `registeredAt` is set once it is confirmed.
  registerTx           String?           @map("register_tx")
  registerTxValidUntil DateTime?         @map("register_tx_valid_until")
  registeredAt         DateTime?         @map("registered_at")
  consentHash          String?           @map("consent_hash")
  consentTx            String?           @map("consent_tx")
  consentAt            DateTime?         @map("consent_at")
  linkedAt             DateTime?         @map("linked_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  organization         Organization      @relation(fields: [organizationId], references: [id])
  collectionCenter     CollectionCenter? @relation(fields: [collectionCenterId], references: [id])
  botConversation      BotConversation?

  @@unique([organizationId, coopFarmerId])
  @@map("farmers")
}

/// State of the bot's conversation with a Telegram chat. Stored in the
/// database so registration can resume where it left off, even if the
/// backend restarts.
model BotConversation {
  chatId    BigInt   @id @map("chat_id")
  farmerId  String?  @unique @map("farmer_id")
  language  String?
  step      String
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  farmer    Farmer?  @relation(fields: [farmerId], references: [id], onDelete: SetNull)

  @@map("bot_conversations")
}

// ── integrations ──────────────────────────────────────────────────────────

/// A message received from an integration partner (VoiceLedger's farmer bot).
/// Stored so that retries get the same answer, a reused `eventId` with other
/// content is rejected, and every on-chain action can be traced back to the
/// message that caused it.
model IntegrationEvent {
  id          String                 @id @default(uuid())
  /// Who sent it, e.g. `voiceledger`.
  source      String
  /// The sender's ID for the event; unique per source.
  eventId     String                 @map("event_id")
  type        String
  /// SHA-256 of the event's type and data (canonical JSON), to detect a
  /// reused `eventId`.
  payloadHash String                 @map("payload_hash")
  payload     Json
  status      IntegrationEventStatus @default(PROCESSING)
  /// The response returned to the sender, replayed on retries.
  httpStatus  Int?                   @map("http_status")
  response    Json?
  txHash      String?                @map("tx_hash")
  errorCode   String?                @map("error_code")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@unique([source, eventId])
  @@map("integration_events")
}

// ── enums ─────────────────────────────────────────────────────────────────

/// Staff roles. The order and names follow the contract's `Role` enum
/// (without `Farmer`, which is not staff).
enum StaffRole {
  COLLECTOR
  COMMITTEE_MEMBER
  INDUSTRY_MANAGER
  STORE_KEEPER
  EXPORT_MANAGER
}

enum OrganizationKind {
  COOPERATIVE
  UNION
}

enum FarmerStatus {
  /// Loaded from the cooperative's list; has not talked to the bot yet.
  PRELOADED
  /// Identified in the bot with their ID and registered on chain.
  LINKED
  /// Completed their farm profile in the bot.
  REGISTERED
  /// Accepted the EUDR consent in the bot.
  CONSENTED
}

enum IntegrationEventStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum NotificationLevel {
  WARNING
  INFO
  ERROR
}
