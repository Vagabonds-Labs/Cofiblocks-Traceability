# Backend image.
#
#   docker build -t cofiblocks-backend .
#
# On startup it applies pending migrations and starts the API on port 4000.
# Environment variables (database, JWT secrets, Stellar…) are passed at run
# time: the backend does not start without valid JWT secrets.

# ── Build ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# Prisma needs OpenSSL to pick its engine on Alpine.
RUN apk add --no-cache openssl

WORKDIR /app

# The Prisma schema and config go in before installing: `postinstall` runs
# `prisma generate`, which needs them.
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma/
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
# Notification translations are imported from src/utils.
COPY locales ./locales
RUN npm run build

# Drop dev dependencies and keep the already generated Prisma client
# (node_modules/.prisma).
RUN npm prune --omit=dev && npm cache clean --force

# ── Runtime ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS production

ENV NODE_ENV=production

WORKDIR /app

# dumb-init for signal handling; OpenSSL for the Prisma engine.
RUN apk add --no-cache dumb-init openssl

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

COPY --from=builder --chown=nodejs:nodejs /app/package*.json /app/prisma.config.ts ./
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
# The compiled code reads the translations from /app/locales.
COPY --from=builder --chown=nodejs:nodejs /app/locales ./locales

USER nodejs

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)}).on('error', () => process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]

CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
