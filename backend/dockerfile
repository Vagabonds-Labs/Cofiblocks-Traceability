# Imagen del backend.
#
#   docker build -t cofiblocks-backend .
#
# Al arrancar aplica las migraciones pendientes y levanta la API en el puerto
# 4000. Las variables de entorno (base, secretos JWT, Stellar…) se pasan en
# tiempo de ejecución: el backend no arranca sin secretos JWT válidos.

# ── Build ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# Prisma necesita OpenSSL para elegir su motor en Alpine.
RUN apk add --no-cache openssl

WORKDIR /app

# El schema y la config de Prisma van antes de instalar: el `postinstall`
# corre `prisma generate` y los necesita.
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma/
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
# Las traducciones de las notificaciones se importan desde src/utils.
COPY locales ./locales
RUN npm run build

# Quita las dependencias de desarrollo y conserva el cliente de Prisma ya
# generado (node_modules/.prisma).
RUN npm prune --omit=dev && npm cache clean --force

# ── Runtime ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS production

ENV NODE_ENV=production

WORKDIR /app

# dumb-init para manejar señales; OpenSSL para el motor de Prisma.
RUN apk add --no-cache dumb-init openssl

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

COPY --from=builder --chown=nodejs:nodejs /app/package*.json /app/prisma.config.ts ./
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
# El código compilado lee las traducciones desde /app/locales.
COPY --from=builder --chown=nodejs:nodejs /app/locales ./locales

USER nodejs

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)}).on('error', () => process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]

CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
