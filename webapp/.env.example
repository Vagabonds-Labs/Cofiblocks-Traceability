# URL del backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# testnet | mainnet — define la red contra la que firma la wallet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

NEXT_PUBLIC_ENV=development

# Tiene que ser igual a JWT_ACCESS_SECRET del backend: el middleware la usa
# para leer el rol del token y proteger /admin y /profile.
JWT_SECRET=

# Cavos: login con Telegram y email, y la wallet de Stellar del usuario.
# App ID del dashboard de Cavos (es público). Vacío = sólo login con wallet.
# En el dashboard hay que registrar el origen de la web (http://localhost:3000,
# staging…): el vault de Cavos sólo carga en orígenes registrados.
NEXT_PUBLIC_CAVOS_APP_ID=
# Entorno de la consola de Cavos: production (por defecto) o development.
NEXT_PUBLIC_CAVOS_ENVIRONMENT=
