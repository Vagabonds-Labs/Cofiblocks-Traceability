# Backend URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# testnet | mainnet — the network the wallet signs for
NEXT_PUBLIC_STELLAR_NETWORK=testnet

NEXT_PUBLIC_ENV=development

# Must match the backend's JWT_ACCESS_SECRET: the middleware uses it to read
# the role from the token and protect /admin and /profile.
JWT_SECRET=

# Cavos: Telegram and email login, and the user's Stellar wallet.
# App ID from the Cavos dashboard (it is public). Empty = wallet login only.
# The web app's origin must be registered in the dashboard
# (http://localhost:3000, staging…): the Cavos vault only loads on registered
# origins.
NEXT_PUBLIC_CAVOS_APP_ID=
# Cavos console environment: production (default) or development.
NEXT_PUBLIC_CAVOS_ENVIRONMENT=
