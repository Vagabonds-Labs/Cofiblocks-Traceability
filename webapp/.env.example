# URL del backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# testnet | mainnet — define la red contra la que firma la wallet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

NEXT_PUBLIC_ENV=development

# Login con email/Google (Privy). El App ID es público.
NEXT_PUBLIC_PRIVY_APP_ID=cmtxa872600g30bi9rpxtf29v

# Tiene que ser igual a JWT_ACCESS_SECRET del backend: el middleware la usa
# para leer el rol del token y proteger /admin y /profile.
JWT_SECRET=

# Cavos (login con Telegram y email). Se completa cuando tengamos el App ID.
NEXT_PUBLIC_CAVOS_APP_ID=
